# deploy/options/.env (chmod 600). Copy the values from deploy/scanner/.env:
#   grep -E '^(IB_PORT|TELEGRAM_BOT_TOKEN|TELEGRAM_CHAT_ID|BACKUP_S3_URI)=' ../scanner/.env > .env
IB_PORT=4004
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_S3_URI=s3://<bucket>/oparli
# Only if `docker network ls` shows another name for the scanner's network:
# GATEWAY_NETWORK=scanner_scannernet
