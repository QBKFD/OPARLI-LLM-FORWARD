# Dry-run stack settings: copy to .env in this directory, chmod 600, fill in.
# This file is read only by the dry-run project; production's .env is untouched.

# A SEPARATE Telegram bot for the dry run (create one with @BotFather). Never
# production's token: two processes long-polling one bot take each other's
# replies. check_env.sh refuses a token equal to production's.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instrument (datafeed.instrument presets: XAUUSD, BTCUSD). Override the
# history whatToShow if step 1 (tools/ibkr_instrument_check.py) says so.
INSTRUMENT=BTCUSD
#INSTRUMENT_WHAT_TO_SHOW=AGGTRADES

# The feed's gateway client id: must not be used by anything else on the gateway.
DRYRUN_FEED_IB_CLIENT_ID=44
# Production's paper relay port and network (project "scanner" -> scanner_scannernet).
IB_PORT=4004
PROD_NETWORK=scanner_scannernet

# Backups of the dry run, if you run them (README.md): must be under a dryrun/ prefix.
BACKUP_S3_URI=s3://YOUR-BUCKET/oparli/dryrun
