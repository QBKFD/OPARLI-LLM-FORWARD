# Copy to .env on the server and fill in. NEVER commit the real .env.

# ---- IBKR Gateway login ----
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
TRADING_MODE=paper           # paper = same market data, zero order risk (recommended)
IB_PORT=4004                 # 4004 for paper, 4003 for live (socat relay ports) — must match TRADING_MODE
READ_ONLY_API=yes            # scanner only reads market data; keep this yes
AUTO_RESTART_TIME=05:15 PM   # IBC auto-restarts Gateway daily (no re-login needed), in TIME_ZONE
TIME_ZONE=America/New_York   # 5:15 PM New York is always inside gold's 17:00-18:00 ET break
VNC_SERVER_PASSWORD=change_me # lets you VNC in (over SSH tunnel) for the weekly 2FA tap

# ---- Scanner ----
IB_CLIENT_ID=11
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ---- Bar source (docs/DEPLOY_RUNBOOK.md) ----
SCANNER_BAR_SOURCE=ibkr      # ibkr (default, the rollback) | stream (bars from the datafeed)
#COMPOSE_PROFILES=stream     # uncomment to run redis + feed + recorder (needed for stream)
FEED_IB_CLIENT_ID=31         # the feed's gateway client id; must differ from 11/21/996/999
SCANNER_STREAM_CONSUMER=scanner-1   # keep stable: unacked entries go back to this name

# ---- Backups (backup.sh; credentials from the instance IAM role, not here) ----
BACKUP_S3_URI=s3://your-backup-bucket/oparli/scanner   # journal/, store/ and archive/ go under it
