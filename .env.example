# Database
DATABASE_URL=postgresql://user:password@localhost:5432/oparli_database

# API Security
API_KEY=your-generated-api-key-here

# LLM Providers
GOOGLE_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Environment (development = Gemini, production = Claude)
ENV=development

# Interactive Brokers
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# Server (for SSH tunnel / deployment)
OPARLI_SERVER_HOST=your-server-ip
OPARLI_SSH_KEY=~/.ssh/id_rsa

# Frontend (create frontend/.env for Vite)
# VITE_API_BASE_URL=https://oparli.com
# VITE_WS_URL=wss://oparli.com
# VITE_API_KEY=your-api-key
