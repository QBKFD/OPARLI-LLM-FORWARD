# Database
DATABASE_URL=postgresql://user:password@localhost:5432/oparli_database

# API Security
API_KEY=your-generated-api-key-here

# LLM Providers
GOOGLE_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Environment (development = Gemini, production = Claude)
ENV=development

# Interactive Brokers
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# Server (for SSH tunnel / deployment)
OPARLI_SERVER_HOST=your-server-ip
OPARLI_SSH_KEY=~/.ssh/id_rsa

# Frontend (create frontend/.env for Vite)
# VITE_API_BASE_URL=https://oparli.com
# VITE_WS_URL=wss://oparli.com
# VITE_API_KEY=your-api-key

# Datafeed (datafeed/ package, local only)
REDIS_URL=redis://<host>:6379/0
# Tests only: a THROWAWAY Redis; the test suite flushes this DB.
# REDIS_TEST_URL=redis://<host>:6379/15
# Datafeed source: replay (default, no IBKR) | ibkr (LOCAL PAPER gateway only).
# The ibkr source reads IB_HOST / IB_PORT / IB_CLIENT_ID above; its client id
# must differ from every other client of that gateway (the scanner uses 11, 21).
DATAFEED_SOURCE=replay
DATAFEED_REPLAY_PARQUET=database/ohlcv_data/XAUUSD_1min_UTC_clean.parquet
# DATAFEED_REPLAY_START=2025-06-11
# DATAFEED_REPLAY_END=2025-06-12
DATAFEED_REPLAY_BARS_PER_S=0
